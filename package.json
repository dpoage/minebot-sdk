{
  "name": "minebot-sdk",
  "version": "0.1.0",
  "description": "Harness-neutral Minecraft bodies for AI agents, built on Mineflayer.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./kit": {
      "minebot-sdk:source": "./src/kit/public.ts",
      "types": "./dist/kit/public.d.ts",
      "default": "./dist/kit/public.js"
    },
    "./client": {
      "minebot-sdk:source": "./src/client/public.ts",
      "types": "./dist/client/public.d.ts",
      "default": "./dist/client/public.js"
    },
    "./testing": {
      "minebot-sdk:source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/kit/kits",
    "wiki",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "minebot": "dist/cli.js"
  },
  "scripts": {
    "minebot": "node --conditions=minebot-sdk:source src/cli.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "dev-server": "node scripts/dev-server.ts",
    "typecheck": "tsc",
    "test": "node --conditions=minebot-sdk:source --test test/",
    "wiki:check": "node --conditions=minebot-sdk:source scripts/wiki-check.ts",
    "wiki:reference": "node --conditions=minebot-sdk:source scripts/wiki-reference.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-block": "^1.23.0",
    "prismarine-entity": "^2.6.0",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "^1.12.0",
    "vec3": "^0.1.10",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
