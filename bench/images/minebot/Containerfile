# minebot runtime: the body sidecar (see bench/gen-tasks.ts). The agent's container uses
# bench/images/client instead, so that it has none of this.
# Build context: the repository root (see bench/build-images.sh).
FROM docker.io/library/node:24-slim

WORKDIR /opt/minebot
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY src ./src
# The grading snapshot that the body takes after the agent is done (bench/verify/snapshot.ts).
COPY bench/verify ./bench/verify
COPY wiki ./wiki

RUN printf '#!/bin/sh\nexec node --conditions=minebot-sdk:source /opt/minebot/src/cli.ts "$@"\n' > /usr/local/bin/minebot \
 && chmod +x /usr/local/bin/minebot

WORKDIR /root
